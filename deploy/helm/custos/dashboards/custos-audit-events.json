{
  "annotations": { "list": [] },
  "description": "Audit-event health for the Custos platform: cross-service audit emit failures, retention sweeps, alert dispatch, and exporter-config status. Datasource is selectable via the Data source variable.",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["custos", "audit", "observability"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "current": {},
        "options": [],
        "regex": "",
        "skipUrlSync": false
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "title": "Custos — Audit Events",
  "uid": "custos-audit-events",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Audit emit failures by service",
      "description": "Non-zero means a service could not durably record an audit event. Cross-references the auth/catalog/connector custos_audit_emit_failures_total counters.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (app, event_type) (rate(custos_audit_emit_failures_total[5m]))",
          "legendFormat": "{{app}} / {{event_type}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Retention rows deleted by kind",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "rps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (kind) (rate(custos_obs_audit_retention_rows_deleted_total[5m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Retention sweep age",
      "description": "Time since the last retention sweep completed. A growing value means the retention worker has stalled.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 86400 },
              { "color": "red", "value": 172800 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "time() - max(custos_obs_audit_retention_last_run_timestamp_seconds)",
          "legendFormat": "age"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Exporter config status",
      "description": "1 = applied, 0 = rejected. Pairs with the exporter-config-rejected alert rule.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "rejected" }, "1": { "text": "applied" } } }
          ]
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "min(custos_obs_exporter_config_status)",
          "legendFormat": "status"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Exporter config changes by outcome",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (outcome) (rate(custos_obs_exporter_config_changes_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Alert dispatch by outcome / sink",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (rule, sink, outcome) (rate(custos_obs_alert_dispatch_total[5m]))",
          "legendFormat": "{{rule}} → {{sink}} ({{outcome}})"
        }
      ]
    }
  ]
}
