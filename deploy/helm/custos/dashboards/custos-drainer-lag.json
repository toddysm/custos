{
  "annotations": { "list": [] },
  "description": "Audit outbox drainer backlog for the observability-audit-service. Tracks custos_obs_audit_outbox_lag_rows, the gauge behind the audit-drain-lagging alert. Datasource is selectable via the Data source variable.",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": ["custos", "audit", "drainer"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "current": {},
        "options": [],
        "regex": "",
        "skipUrlSync": false
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "title": "Custos — Audit Drainer Lag",
  "uid": "custos-drainer-lag",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Max outbox lag (rows)",
      "description": "Worst-case backlog across all audit pipelines right now.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 10000 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(custos_obs_audit_outbox_lag_rows)",
          "legendFormat": "max lag"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total outbox lag (rows)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(custos_obs_audit_outbox_lag_rows)",
          "legendFormat": "total lag"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pipelines with backlog",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count(custos_obs_audit_outbox_lag_rows > 0)",
          "legendFormat": "pipelines"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Outbox lag by pipeline",
      "description": "Per-pipeline backlog over time. A sustained climb means the drainer cannot keep up with audit writes; correlate with the audit-drain-lagging alert.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "custos_obs_audit_outbox_lag_rows",
          "legendFormat": "{{pipeline_id}}"
        }
      ]
    }
  ]
}
