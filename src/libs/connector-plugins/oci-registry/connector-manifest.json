{
  "apiVersion": "custos.dev/connector-manifest/v1",
  "kind": "ConnectorManifest",
  "metadata": {
    "type": "custos-oci-registry",
    "version": "1.0.0",
    "contractVersion": "1"
  },
  "spec": {
    "description": "Reference OCI registry connector. Exercises every Tier-1 OCI capability and both push + pull event-delivery modes. Used as the worked example for the connector-plugin-author developer guide and as the multi-connector test fixture for the connector-service integration suite (CONN-IMPL-031).",
    "capabilities": [
      "oci.pull",
      "oci.push",
      "oci.copy",
      "oci.list-tags",
      "oci.list-referrers"
    ],
    "target": {
      "kind": "oci-registry",
      "endpoint": "https://registry.example.com",
      "verifyTls": true,
      "config": {
        "repositoryNamespace": "sample"
      }
    },
    "credentials": {
      "authenticationType": "azure-key-vault",
      "authentication": {
        "vaultUri": "https://sample-akv.vault.azure.net",
        "secretName": "registry-token",
        "connectorIdentity": "azure://managed-identity/custos-connector-mi"
      }
    },
    "events": {
      "delivery": [
        "push",
        "pull"
      ],
      "produced": [
        "oci.image.pushed",
        "oci.tag.updated"
      ],
      "pull": {
        "cursorEncoding": "oci-list-tags-v1",
        "initialCursorBehavior": "now"
      }
    }
  }
}
