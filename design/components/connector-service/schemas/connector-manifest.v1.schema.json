{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://custos.dev/schemas/connector-manifest.v1.schema.json",
  "title": "Custos Connector Manifest v1",
  "description": "Strict schema for ConnectorManifest v1 artifact payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "custos.dev/connector-manifest/v1"
    },
    "kind": {
      "const": "ConnectorManifest"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "contractVersion"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{1,62})$",
          "description": "Connector type slug, for example oci-registry."
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
          "description": "SemVer for the connector type version descriptor."
        },
        "contractVersion": {
          "const": "1",
          "description": "Connector contract version supported by this manifest."
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "capabilities",
        "supportedModes",
        "target",
        "credentials",
        "identityModels",
        "events"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "supportedModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "push",
              "pull"
            ]
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "endpoint",
            "config"
          ],
          "properties": {
            "kind": {
              "enum": [
                "oci-registry",
                "azure-blob-storage",
                "amazon-s3-bucket"
              ]
            },
            "endpoint": {
              "type": "string",
              "pattern": "^https://[^\\s/$.?#].[^\\s]*$",
              "description": "Base endpoint URI for the selected target kind."
            },
            "verifyTls": {
              "type": "boolean",
              "default": true
            },
            "config": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": true,
              "description": "Target-specific configuration bag interpreted based on target.kind."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "oci-registry"
                  }
                }
              },
              "then": {
                "properties": {
                  "config": {
                    "$ref": "#/$defs/ociRegistryConfig"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "azure-blob-storage"
                  }
                }
              },
              "then": {
                "properties": {
                  "config": {
                    "$ref": "#/$defs/azureBlobStorageConfig"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "amazon-s3-bucket"
                  }
                }
              },
              "then": {
                "properties": {
                  "config": {
                    "$ref": "#/$defs/amazonS3BucketConfig"
                  }
                }
              }
            }
          ]
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authenticationType",
            "authentication"
          ],
          "properties": {
            "authenticationType": {
              "anyOf": [
                {
                  "enum": [
                    "azure-key-vault",
                    "amazon-kms",
                    "azure-managed-identity",
                    "oidc"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^x-[a-z0-9][a-z0-9.-]{1,63}$"
                }
              ]
            },
            "authentication": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": true,
              "description": "Authentication property bag interpreted based on credentials.authenticationType."
            }
          }
        },
        "identityModels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identityModel"
          }
        },
        "federatedProviders": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/providerName"
          },
          "description": "Required when identityModels contains federated."
        },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "produced"
          ],
          "properties": {
            "produced": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/eventType"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "credentials": {
                "properties": {
                  "authenticationType": {
                    "enum": [
                      "azure-key-vault",
                      "amazon-kms"
                    ]
                  }
                },
                "required": [
                  "authenticationType"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "identityModels": {
                "contains": {
                  "const": "kms"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "credentials": {
                "properties": {
                  "authenticationType": {
                    "const": "azure-managed-identity"
                  }
                },
                "required": [
                  "authenticationType"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "identityModels": {
                "contains": {
                  "const": "workload"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "credentials": {
                "properties": {
                  "authenticationType": {
                    "const": "oidc"
                  }
                },
                "required": [
                  "authenticationType"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "identityModels": {
                "contains": {
                  "const": "federated"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "identityModels": {
                "contains": {
                  "const": "federated"
                }
              }
            }
          },
          "then": {
            "required": [
              "federatedProviders"
            ]
          }
        }
      ]
    }
  },
  "$defs": {
    "ociRegistryConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryNamespace"
      ],
      "properties": {
        "repositoryNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "azureBlobStorageConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storageAccount",
        "container"
      ],
      "properties": {
        "storageAccount": {
          "type": "string",
          "pattern": "^[a-z0-9]{3,24}$"
        },
        "container": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{1,61})[a-z0-9]$"
        }
      }
    },
    "amazonS3BucketConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket",
        "region"
      ],
      "properties": {
        "bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z]{2}-[a-z]+-[0-9]$"
        }
      }
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$",
      "description": "Dot-delimited capability token, for example oci.pull or event.push."
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$",
      "description": "Dot-delimited normalized event type token."
    },
    "providerName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$",
      "description": "Federation provider identifier, for example oidc, spiffe, saml-bridge."
    },
    "identityModel": {
      "anyOf": [
        {
          "enum": [
            "kms",
            "workload",
            "federated"
          ]
        },
        {
          "type": "string",
          "pattern": "^x-[a-z0-9][a-z0-9.-]{1,63}$",
          "description": "Vendor extension identity model."
        }
      ]
    }
  }
}
