{
  "apiVersion": "custos.dev/connector-manifest/v1",
  "kind": "ConnectorManifest",
  "metadata": {
    "type": "oci-registry",
    "version": "2.3.1-akv.1",
    "contractVersion": "1"
  },
  "spec": {
    "description": "OCI registry connector using Azure Key Vault for secret material.",
    "capabilities": [
      "oci.pull",
      "oci.push",
      "oci.tag",
      "event.push",
      "event.pull"
    ],
    "supportedModes": [
      "push",
      "pull"
    ],
    "target": {
      "kind": "oci-registry",
      "endpoint": "https://myorg.azurecr.io",
      "repositoryPrefix": "team-a",
      "verifyTls": true
    },
    "credentials": {
      "sourceType": "kms",
      "kms": {
        "provider": "azure-key-vault",
        "secretRef": "https://custos-akv.vault.azure.net/secrets/registry-token",
        "connectorIdentity": "azure://managed-identity/custos-connector-mi"
      }
    },
    "identityModels": [
      "kms"
    ],
    "events": {
      "produced": [
        "oci.image.pushed",
        "oci.tag.updated"
      ]
    }
  }
}
