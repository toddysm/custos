{
  "apiVersion": "custos.dev/connector-manifest/v1",
  "kind": "ConnectorManifest",
  "metadata": {
    "type": "oci-registry",
    "version": "2.3.1-awskms.1",
    "contractVersion": "1"
  },
  "spec": {
    "description": "OCI registry connector using AWS KMS-protected secret material.",
    "capabilities": [
      "oci.pull",
      "oci.push",
      "oci.copy"
    ],
    "target": {
      "kind": "oci-registry",
      "endpoint": "https://123456789012.dkr.ecr.us-east-1.amazonaws.com",
      "verifyTls": true,
      "config": {
        "repositoryNamespace": "prod"
      }
    },
    "credentials": {
      "authenticationType": "amazon-kms",
      "authentication": {
        "secretRef": "arn:aws:secretsmanager:us-east-1:123456789012:secret:registry/auth-token",
        "connectorIdentity": "aws://iam-role/custos-connector-role"
      }
    },
    "events": {
      "delivery": [
        "push",
        "pull"
      ],
      "produced": [
        "oci.image.pushed",
        "oci.tag.updated"
      ],
      "pull": {
        "cursorEncoding": "oci-list-tags-v1",
        "initialCursorBehavior": "now"
      }
    }
  }
}
